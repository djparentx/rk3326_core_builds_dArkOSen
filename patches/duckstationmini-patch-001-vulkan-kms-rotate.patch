+  // dArkOSen: rotated panel on VK_KHR_display (SDL3 KMSDRM). The window is landscape (e.g. 854x480) but the
+  // display surface only exists at the panel's native portrait size (e.g. 480x854), and the plane can't rotate.
+  // Keep the swap chain at the native size with an identity transform, and prerotate everything we draw.
+  // Rotate270Clockwise matches HAL_TRANSFORM_ROT_270 in sdl3-patch-0001-kmsdrm-rga-rotate.patch.
+  if (const VkExtent2D native_size = surface_caps.surfaceCapabilities.currentExtent;
+      m_window_info.type == WindowInfoType::SDL && window_prerotation == WindowInfoPrerotation::Identity &&
+      native_size.width != UINT32_MAX && native_size.width != native_size.height &&
+      native_size.width == m_window_info.surface_height && native_size.height == m_window_info.surface_width)
+  {
+    size = native_size;
+    window_size = VkExtent2D{native_size.height, native_size.width};
+    window_prerotation = WindowInfoPrerotation::Rotate270Clockwise;
+    INFO_LOG("Rotated KMSDRM panel: swap chain {}x{}, drawing {}x{}", size.width, size.height, window_size.width,
+             window_size.height);
+  }
+
   VkCompositeAlphaFlagBitsKHR alpha = VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR;
