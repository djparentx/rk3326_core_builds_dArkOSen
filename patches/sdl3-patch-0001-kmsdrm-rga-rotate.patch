+/* dArkOS: rotation is decided at runtime. When /home/ark/.config/.DEVICE
+   contains "rotated" (case-insensitive), the portrait panel is driven as a
+   landscape screen using the RGA 2D blitter (ROT_270). Checked once, cached. */
+#define KMSDRM_DEVICE_FLAG_FILE "/home/ark/.config/.DEVICE"
+#define KMSDRM_DEVICE_FLAG_TAG  "rotated"
+
+static bool KMSDRM_DeviceIsRotated(void)
+{
+    static bool checked = false;
+    static bool rotated = false;
+
+    if (!checked) {
+        char *buf = (char *)SDL_LoadFile(KMSDRM_DEVICE_FLAG_FILE, NULL);
+        checked = true;
+        if (buf) {
+            rotated = SDL_strcasestr(buf, KMSDRM_DEVICE_FLAG_TAG) != NULL;
+            SDL_free(buf);
+        }
+    }
+    return rotated;
+}
+
+static void KMSDRM_DeinitRotateBuffer(SDL_DisplayData *dispdata)
+{
+    int i;
+
+    if (!dispdata->rga_inited) {
+        return;
+    }
+    for (i = 0; i < RGA_BUFFERS_MAX; ++i) {
+        if (dispdata->rga_buffers[i]) {
+            close(dispdata->rga_buffer_prime_fds[i]);
+            KMSDRM_gbm_bo_destroy(dispdata->rga_buffers[i]);
+            dispdata->rga_buffers[i] = NULL;
+        }
+    }
+    if (dispdata->src_info.fd >= 0) {
+        close(dispdata->src_info.fd);
+        dispdata->src_info.fd = -1;
+    }
+    c_RkRgaDeInit();
+    dispdata->rga_inited = false;
+}
+
+static bool KMSDRM_InitRotateBuffer(SDL_VideoDevice *_this, SDL_DisplayData *dispdata)
+{
+    SDL_VideoData *viddata = _this->internal;
+    const int w = dispdata->mode.hdisplay; // panel native (portrait)
+    const int h = dispdata->mode.vdisplay;
+    int aligned_h = h;
+    int i;
+
+    KMSDRM_DeinitRotateBuffer(dispdata);
+
+    if (aligned_h % 32 != 0) {
+        aligned_h = (h + 32) & (~31);
+    }
+
+    c_RkRgaInit();
+    dispdata->rga_inited = true;
+    dispdata->rga_buffer_index = 0;
+
+    for (i = 0; i < RGA_BUFFERS_MAX; ++i) {
+        dispdata->rga_buffers[i] = KMSDRM_gbm_bo_create(viddata->gbm_dev, w, aligned_h,
+                                                        GBM_FORMAT_XRGB8888,
+                                                        GBM_BO_USE_SCANOUT | GBM_BO_USE_RENDERING);
+        if (!dispdata->rga_buffers[i]) {
+            KMSDRM_DeinitRotateBuffer(dispdata);
+            return SDL_SetError("Could not create RGA rotation buffer");
+        }
+        dispdata->rga_buffer_prime_fds[i] = KMSDRM_gbm_bo_get_fd(dispdata->rga_buffers[i]);
+    }
+
+    SDL_zero(dispdata->src_info);
+    dispdata->src_info.fd = -1;
+    dispdata->src_info.mmuFlag = 1;
+    dispdata->src_info.rotation = HAL_TRANSFORM_ROT_270;
+    // source is the landscape GBM surface: width/height swapped vs. the panel
+    rga_set_rect(&dispdata->src_info.rect, 0, 0, h, w, aligned_h, w, RK_FORMAT_BGRA_8888);
+
+    SDL_zero(dispdata->dst_info);
+    dispdata->dst_info.fd = -1;
+    dispdata->dst_info.mmuFlag = 1;
+    rga_set_rect(&dispdata->dst_info.rect, 0, 0, w, h, w, h, RK_FORMAT_BGRA_8888);
+
+    return true;
+}
+
+KMSDRM_FBInfo *KMSDRM_RotatedFBFromBO(SDL_VideoDevice *_this, SDL_DisplayData *dispdata, struct gbm_bo *bo)
+{
+    struct gbm_bo *rga_bo;
+
+    if (dispdata->src_info.fd >= 0) {
+        close(dispdata->src_info.fd);
+    }
+    dispdata->src_info.fd = KMSDRM_gbm_bo_get_fd(bo);
+    dispdata->dst_info.fd = dispdata->rga_buffer_prime_fds[dispdata->rga_buffer_index];
+
+    if (c_RkRgaBlit(&dispdata->src_info, &dispdata->dst_info, NULL) < 0) {
+        SDL_LogError(SDL_LOG_CATEGORY_VIDEO, "RGA blit failed");
+    }
+
+    rga_bo = dispdata->rga_buffers[dispdata->rga_buffer_index];
+    dispdata->rga_buffer_index = (dispdata->rga_buffer_index + 1) % RGA_BUFFERS_MAX;
+
+    return KMSDRM_FBFromBO(_this, rga_bo);
+}
