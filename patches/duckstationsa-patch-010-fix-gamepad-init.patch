--- a/src/frontend-common/sdl_controller_interface.cpp
+++ b/src/frontend-common/sdl_controller_interface.cpp
@@ -62,6 +62,19 @@
 
   // we should open the controllers as the connected events come in, so no need to do any more here
   m_sdl_subsystem_initialized = true;
+
+  // Devices already connected before SDL_InitSubSystem only fire SDL_JOYDEVICEADDED,
+  // not SDL_CONTROLLERDEVICEADDED, so they never get opened as game controllers even
+  // when a mapping exists. Enumerate and open them now that the db is loaded.
+  const int num_joysticks = SDL_NumJoysticks();
+  for (int i = 0; i < num_joysticks; i++)
+  {
+    if (SDL_IsGameController(i))
+      OpenGameController(i);
+    else
+      OpenJoystick(i);
+  }
+
   return true;\n }