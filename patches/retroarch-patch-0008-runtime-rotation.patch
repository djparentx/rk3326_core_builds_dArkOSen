+/* dArkOS: rotation is decided at runtime, not at compile time. When
+ * /home/ark/.config/.DEVICE contains "rotated" (case-insensitive, same
+ * convention as the dArkOSen Kodi build), this driver drives the panel
+ * as a rotated (portrait-panel-in-landscape-housing) screen. Otherwise
+ * it drives it as a normal landscape panel. Checked once and cached. */
+#define GO2_DRM_DEVICE_FLAG_FILE "/home/ark/.config/.DEVICE"
+#define GO2_DRM_DEVICE_FLAG_TAG  "rotated"
+
+static bool go2_drm_device_is_rotated(void)
+{
+   static bool checked = false;
+   static bool rotated = false;
+
+   if (!checked)
+   {
+      char buf[256];
+      FILE *f  = fopen(GO2_DRM_DEVICE_FLAG_FILE, "r");
+      checked  = true;
+
+      if (f)
+      {
+         size_t len = fread(buf, 1, sizeof(buf) - 1, f);
+         fclose(f);
+         buf[len] = '\0';
+
+         if (len >= strlen(GO2_DRM_DEVICE_FLAG_TAG))
+         {
+            size_t tag_len = strlen(GO2_DRM_DEVICE_FLAG_TAG);
+            size_t i;
+
+            for (i = 0; buf[i] != '\0' && !rotated; i++)
+            {
+               size_t j;
+               for (j = 0; j < tag_len && buf[i + j] != '\0'; j++)
+               {
+                  if (tolower((unsigned char)buf[i + j]) !=
+                        tolower((unsigned char)GO2_DRM_DEVICE_FLAG_TAG[j]))
+                     break;
+               }
+               if (j == tag_len)
+                  rotated = true;
+            }
+         }
+      }
+   }
+
+   return rotated;
+}
