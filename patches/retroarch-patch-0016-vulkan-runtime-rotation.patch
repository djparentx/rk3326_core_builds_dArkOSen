+/* Runtime rotation: staging holds the portrait rect (vp_h wide,
+ * vp_w tall). Rotate back to landscape BGR24, bottom-up. */
+static void vulkan_read_viewport_rotated(const uint8_t *src,
+      unsigned stride, VkFormat format, uint8_t *buffer,
+      unsigned vp_width, unsigned vp_height)
+{
+   int x, y;
+   bool rgba = (format == VK_FORMAT_R8G8B8A8_UNORM)
+            || (format == VK_FORMAT_A8B8G8R8_UNORM_PACK32);
+
+   buffer += 3 * (vp_height - 1) * vp_width;
+   for (y = 0; y < (int)vp_height; y++, buffer -= 3 * vp_width)
+   {
+      for (x = 0; x < (int)vp_width; x++)
+      {
+         const uint8_t *p = src + (vp_width - 1 - x) * stride + 4 * y;
+         if (rgba)
+         {
+            buffer[3 * x + 2] = p[0];
+            buffer[3 * x + 1] = p[1];
+            buffer[3 * x + 0] = p[2];
+         }
+         else
+         {
+            buffer[3 * x + 0] = p[0];
+            buffer[3 * x + 1] = p[1];
+            buffer[3 * x + 2] = p[2];
+         }
+      }
+   }
+}
