diff --git a/src/video/sdl2/SDL_sdl2vulkan.c b/src/video/sdl2/SDL_sdl2vulkan.c
new file mode 100644
index 0000000..ba94fb0
--- /dev/null
+++ b/src/video/sdl2/SDL_sdl2vulkan.c
@@ -0,0 +1,122 @@
+/*
+  SDL2 backend - Vulkan
+  dArkOSen: forwards the SDL3 Vulkan calls to SDL2 (KMSDRM / VK_KHR_display).
+  SDL2 owns the Vulkan loader and creates the display surface.
+*/
+#include "SDL_internal.h"
+
+#if defined(SDL_VIDEO_DRIVER_SDL2) && defined(SDL_VIDEO_VULKAN)
+
+#include "SDL_sdl2video.h"
+#include "SDL_sdl2vulkan.h"
+
+#define SDL2_VULKAN_MAX_EXTENSIONS 16
+
+static const char *sdl2_vulkan_extensions[SDL2_VULKAN_MAX_EXTENSIONS];
+
+bool SDL2_Vulkan_LoadLibrary_Impl(SDL_VideoDevice *_this, const char *path)
+{
+    void *get_proc_addr;
+
+    if (!SDL2_Vulkan_LoadLibrary || !SDL2_Vulkan_GetVkGetInstanceProcAddr ||
+        !SDL2_Vulkan_GetInstanceExtensions || !SDL2_Vulkan_CreateSurface) {
+        return SDL_SetError("SDL2 backend: SDL2 has no Vulkan support");
+    }
+
+    if (SDL2_Vulkan_LoadLibrary(path) < 0) {
+        return SDL_SetError("SDL2_Vulkan_LoadLibrary failed: %s",
+                            SDL2_GetError ? SDL2_GetError() : "unknown");
+    }
+
+    get_proc_addr = SDL2_Vulkan_GetVkGetInstanceProcAddr();
+    if (!get_proc_addr) {
+        if (SDL2_Vulkan_UnloadLibrary) {
+            SDL2_Vulkan_UnloadLibrary();
+        }
+        return SDL_SetError("SDL2_Vulkan_GetVkGetInstanceProcAddr failed: %s",
+                            SDL2_GetError ? SDL2_GetError() : "unknown");
+    }
+
+    _this->vulkan_config.vkGetInstanceProcAddr = (SDL_FunctionPointer)get_proc_addr;
+    SDL_strlcpy(_this->vulkan_config.loader_path, path ? path : "",
+                sizeof(_this->vulkan_config.loader_path));
+    return true;
+}
+
+void SDL2_Vulkan_UnloadLibrary_Impl(SDL_VideoDevice *_this)
+{
+    if (SDL2_Vulkan_UnloadLibrary) {
+        SDL2_Vulkan_UnloadLibrary();
+    }
+    _this->vulkan_config.vkGetInstanceProcAddr = NULL;
+    _this->vulkan_config.loader_path[0] = '\0';
+}
+
+char const * const *SDL2_Vulkan_GetInstanceExtensions_Impl(SDL_VideoDevice *_this, Uint32 *count)
+{
+    unsigned int sdl2_count = 0;
+
+    if (count) {
+        *count = 0;
+    }
+
+    if (!SDL2_Vulkan_GetInstanceExtensions) {
+        SDL_SetError("SDL2 backend: SDL2 has no Vulkan support");
+        return NULL;
+    }
+
+    /* SDL2 accepts a NULL window here once the loader is loaded. */
+    if (!SDL2_Vulkan_GetInstanceExtensions(NULL, &sdl2_count, NULL)) {
+        SDL_SetError("SDL2_Vulkan_GetInstanceExtensions failed: %s",
+                     SDL2_GetError ? SDL2_GetError() : "unknown");
+        return NULL;
+    }
+
+    if (sdl2_count > SDL2_VULKAN_MAX_EXTENSIONS) {
+        SDL_SetError("SDL2 backend: too many Vulkan instance extensions (%u)", sdl2_count);
+        return NULL;
+    }
+
+    if (!SDL2_Vulkan_GetInstanceExtensions(NULL, &sdl2_count, sdl2_vulkan_extensions)) {
+        SDL_SetError("SDL2_Vulkan_GetInstanceExtensions failed: %s",
+                     SDL2_GetError ? SDL2_GetError() : "unknown");
+        return NULL;
+    }
+
+    if (count) {
+        *count = (Uint32)sdl2_count;
+    }
+    return sdl2_vulkan_extensions;
+}
+
+bool SDL2_Vulkan_CreateSurface_Impl(SDL_VideoDevice *_this, SDL_Window *window, VkInstance instance, const struct VkAllocationCallbacks *allocator, VkSurfaceKHR *surface)
+{
+    SDL_WindowData *data = window->internal;
+
+    /* SDL2 has no allocator parameter; it always uses the default allocator. */
+    (void)allocator;
+
+    if (!data || !data->sdl2_window) {
+        return SDL_SetError("SDL2 backend: no SDL2 window for the Vulkan surface");
+    }
+
+    if (!SDL2_Vulkan_CreateSurface) {
+        return SDL_SetError("SDL2 backend: SDL2 has no Vulkan support");
+    }
+
+    if (!SDL2_Vulkan_CreateSurface(data->sdl2_window, instance, surface)) {
+        return SDL_SetError("SDL2_Vulkan_CreateSurface failed: %s",
+                            SDL2_GetError ? SDL2_GetError() : "unknown");
+    }
+
+    return true;
+}
+
+void SDL2_Vulkan_DestroySurface_Impl(SDL_VideoDevice *_this, VkInstance instance, VkSurfaceKHR surface, const struct VkAllocationCallbacks *allocator)
+{
+    if (_this->vulkan_config.vkGetInstanceProcAddr) {
+        SDL_Vulkan_DestroySurface_Internal((void *)_this->vulkan_config.vkGetInstanceProcAddr, instance, surface, allocator);
+    }
+}
+
+#endif /* SDL_VIDEO_DRIVER_SDL2 && SDL_VIDEO_VULKAN */
