+
+#if defined(SDL_VIDEO_DRIVER_SDL2) && defined(SDL_VIDEO_VULKAN)
+
+#include "../SDL_vulkan_internal.h"
+
+extern bool SDL2_Vulkan_LoadLibrary_Impl(SDL_VideoDevice *_this, const char *path);
+extern void SDL2_Vulkan_UnloadLibrary_Impl(SDL_VideoDevice *_this);
+extern char const * const *SDL2_Vulkan_GetInstanceExtensions_Impl(SDL_VideoDevice *_this, Uint32 *count);
+extern bool SDL2_Vulkan_CreateSurface_Impl(SDL_VideoDevice *_this, SDL_Window *window, VkInstance instance, const struct VkAllocationCallbacks *allocator, VkSurfaceKHR *surface);
+extern void SDL2_Vulkan_DestroySurface_Impl(SDL_VideoDevice *_this, VkInstance instance, VkSurfaceKHR surface, const struct VkAllocationCallbacks *allocator);
