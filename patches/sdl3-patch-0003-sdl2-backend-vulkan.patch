diff --git a/src/video/sdl2/SDL_sdl2window.c b/src/video/sdl2/SDL_sdl2window.c
index 01deb65..00efaca 100644
--- a/src/video/sdl2/SDL_sdl2window.c
+++ b/src/video/sdl2/SDL_sdl2window.c
@@ -30,6 +30,10 @@ bool SDL2_CreateSDLWindow(SDL_VideoDevice *_this, SDL_Window *window, SDL_Proper
     if (window->flags & SDL_WINDOW_OPENGL) {
         sdl2_flags |= SDL2_WINDOW_OPENGL;
     }
+    /* dArkOSen: SDL2 KMSDRM skips GBM/EGL and the RGA rotate buffers for Vulkan windows */
+    if (window->flags & SDL_WINDOW_VULKAN) {
+        sdl2_flags |= SDL2_WINDOW_VULKAN;
+    }
     if (window->flags & SDL_WINDOW_BORDERLESS) {
         sdl2_flags |= SDL2_WINDOW_BORDERLESS;
     }
