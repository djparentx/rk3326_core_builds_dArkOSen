diff --git a/src/video/kmsdrm/SDL_kmsdrmopengles.c b/src/video/kmsdrm/SDL_kmsdrmopengles.c
index 4edde28..d52db3a 100644
--- a/src/video/kmsdrm/SDL_kmsdrmopengles.c
+++ b/src/video/kmsdrm/SDL_kmsdrmopengles.c
@@ -117,20 +117,68 @@ static EGLSyncKHR create_fence(SDL_VideoDevice *_this, int fd)
 /* program exits immediately, or we could leave KMS waiting for a failed/missing   */
 /* fence forever.                                                                  */
 /***********************************************************************************/
+/* Swap timing (debug only). Set SDL_KMSDRM_SWAP_TIMING=<log file path> to
+   enable. Writes avg/max milliseconds of each swap stage every 120 swaps. */
+enum { SWT_EGLSWAP, SWT_FENCE, SWT_LOCK, SWT_FLIPWAIT, SWT_COMMIT, SWT_POST, SWT_TOTAL, SWT_COUNT };
+static FILE *swt_file = NULL;
+static int swt_state = -1; /* -1 unchecked, 0 off, 1 on */
+static Uint64 swt_sum[SWT_COUNT], swt_max[SWT_COUNT];
+static int swt_frames = 0;
+
+static void SWT_Add(int stage, Uint64 start, Uint64 end)
+{
+    const Uint64 d = end - start;
+    swt_sum[stage] += d;
+    if (d > swt_max[stage]) {
+        swt_max[stage] = d;
+    }
+}
+
+static void SWT_EndFrame(void)
+{
+    static const char *names[SWT_COUNT] = { "eglswap", "fence", "lock", "flipwait", "commit", "post", "total" };
+    int i;
+
+    if (++swt_frames < 120) {
+        return;
+    }
+    fprintf(swt_file, "%-10s %10s %10s\n", "stage", "avg_ms", "max_ms");
+    for (i = 0; i < SWT_COUNT; i++) {
+        fprintf(swt_file, "%-10s %10.3f %10.3f\n", names[i],
+                (double)swt_sum[i] / swt_frames / 1000000.0, (double)swt_max[i] / 1000000.0);
+    }
+    fprintf(swt_file, "\n");
+    fflush(swt_file);
+    SDL_zeroa(swt_sum);
+    SDL_zeroa(swt_max);
+    swt_frames = 0;
+}
+
 static bool KMSDRM_GLES_SwapWindowFenced(SDL_VideoDevice *_this, SDL_Window * window)
 {
+    Uint64 swt_t0 = 0, swt_t1 = 0, swt_start = 0;
     SDL_WindowData *windata = ((SDL_WindowData *) window->internal);
     SDL_DisplayData *dispdata = SDL_GetDisplayDriverDataForWindow(window);
     KMSDRM_FBInfo *fb;
     KMSDRM_PlaneInfo info;
     const bool modesetting = windata->egl_surface_dirty;
 
+    if (swt_state < 0) {
+        const char *path = SDL_getenv("SDL_KMSDRM_SWAP_TIMING");
+        swt_file = (path && *path) ? fopen(path, "w") : NULL;
+        swt_state = swt_file ? 1 : 0;
+    }
+
     if (modesetting) {
         KMSDRM_CreateSurfaces(_this, window);
     }
 
     SDL_zero(info);
 
+    if (swt_state > 0) {
+        swt_start = swt_t0 = SDL_GetTicksNS();
+    }
+
     /******************************************************************/
     /* Create the GPU-side FENCE OBJECT. It will be inserted into the */
     /* GL CMDSTREAM exactly at the end of the gl commands that form a */
@@ -150,6 +198,12 @@ static bool KMSDRM_GLES_SwapWindowFenced(SDL_VideoDevice *_this, SDL_Window * wi
         return SDL_EGL_SetError("Failed to swap EGL buffers", "eglSwapBuffers");
     }
 
+    if (swt_state > 0) {
+        swt_t1 = SDL_GetTicksNS();
+        SWT_Add(SWT_EGLSWAP, swt_t0, swt_t1);
+        swt_t0 = swt_t1;
+    }
+
     /******************************************************************/
     /* EXPORT the GPU-side FENCE OBJECT to the fence INPUT FD, so we  */
     /* can pass it into the kernel. Atomic ioctl will pass the        */
@@ -167,6 +221,12 @@ static bool KMSDRM_GLES_SwapWindowFenced(SDL_VideoDevice *_this, SDL_Window * wi
     _this->egl_data->eglDestroySyncKHR(_this->egl_data->egl_display, dispdata->gpu_fence);
     SDL_assert(dispdata->kms_in_fence_fd != -1);
 
+    if (swt_state > 0) {
+        swt_t1 = SDL_GetTicksNS();
+        SWT_Add(SWT_FENCE, swt_t0, swt_t1);
+        swt_t0 = swt_t1;
+    }
+
     /* Lock the buffer that is marked by eglSwapBuffers() to become the
        next front buffer (so it can not be chosen by EGL as back buffer
        to draw on), and get a handle to it to request the pageflip on it.
@@ -181,6 +241,12 @@ static bool KMSDRM_GLES_SwapWindowFenced(SDL_VideoDevice *_this, SDL_Window * wi
         return SDL_SetError("Failed to get a new framebuffer from BO");
     }
 
+    if (swt_state > 0) {
+        swt_t1 = SDL_GetTicksNS();
+        SWT_Add(SWT_LOCK, swt_t0, swt_t1);
+        swt_t0 = swt_t1;
+    }
+
     if (!windata->bo) {
         /* On the first swap, immediately present the new front buffer. Before
            drmModePageFlip can be used the CRTC has to be configured to use
@@ -249,10 +315,25 @@ static bool KMSDRM_GLES_SwapWindowFenced(SDL_VideoDevice *_this, SDL_Window * wi
     /* this must not block so the game can start building another    */
     /* frame, even if the just-requested pageflip hasnt't completed. */
     /*****************************************************************/
+    if (swt_state > 0) {
+        /* Same wait drm_atomic_commit() does first; timed on its own here.
+           The second call inside drm_atomic_commit() is then a no-op. */
+        drm_atomic_waitpending(_this, dispdata);
+        swt_t1 = SDL_GetTicksNS();
+        SWT_Add(SWT_FLIPWAIT, swt_t0, swt_t1);
+        swt_t0 = swt_t1;
+    }
+
     if (drm_atomic_commit(_this, dispdata, false, modesetting)) {
         return SDL_SetError("Failed to issue atomic commit on pageflip");
     }
 
+    if (swt_state > 0) {
+        swt_t1 = SDL_GetTicksNS();
+        SWT_Add(SWT_COMMIT, swt_t0, swt_t1);
+        swt_t0 = swt_t1;
+    }
+
     /* Release the previous front buffer so EGL can chose it as back buffer
        and render on it again. */
     if (windata->bo) {
@@ -283,6 +364,13 @@ static bool KMSDRM_GLES_SwapWindowFenced(SDL_VideoDevice *_this, SDL_Window * wi
     /*****************************************************************/
     _this->egl_data->eglWaitSyncKHR(_this->egl_data->egl_display, dispdata->kms_fence, 0);
 
+    if (swt_state > 0) {
+        swt_t1 = SDL_GetTicksNS();
+        SWT_Add(SWT_POST, swt_t0, swt_t1);
+        SWT_Add(SWT_TOTAL, swt_start, swt_t1);
+        SWT_EndFrame();
+    }
+
     return true;
 }
