diff --git a/src/video/kmsdrm/SDL_kmsdrmvulkan.c b/src/video/kmsdrm/SDL_kmsdrmvulkan.c
index 8fdde58..34471ab 100644
--- a/src/video/kmsdrm/SDL_kmsdrmvulkan.c
+++ b/src/video/kmsdrm/SDL_kmsdrmvulkan.c
@@ -207,6 +207,16 @@ bool KMSDRM_Vulkan_CreateSurface(SDL_VideoDevice *_this,
     int display_index = SDL_GetDisplayIndex(SDL_GetDisplayForWindow(window));
     int i, j;

+    /* dArkOS: on a rotated panel (portrait native mode, see KMSDRM_AddDisplay)
+       the window is reported swapped (e.g. 854x480) while the Vulkan driver
+       only knows the native mode (e.g. 480x854). Match and scan out the native
+       size; the Vulkan app has to rotate its own output. The RGA rotate buffers
+       are only created for GL windows (KMSDRM_CreateSurfaces). */
+    SDL_DisplayData *dispdata = SDL_GetDisplayDriverDataForWindow(window);
+    bool rotated = dispdata && dispdata->rotated;
+    uint32_t surf_w = (uint32_t)(rotated ? window->h : window->w);
+    uint32_t surf_h = (uint32_t)(rotated ? window->w : window->h);
+
     // Get the function pointers for the functions we will use.
     PFN_vkGetInstanceProcAddr vkGetInstanceProcAddr =
         (PFN_vkGetInstanceProcAddr)_this->vulkan_config.vkGetInstanceProcAddr;
@@ -351,8 +361,8 @@ bool KMSDRM_Vulkan_CreateSurface(SDL_VideoDevice *_this,
        scanout a region bigger than the window (we would be reading past the
        buffer, and Vulkan would give us a confusing VK_ERROR_SURFACE_LOST_KHR). */
     for (i = 0; i < mode_count; i++) {
-        if (mode_props[i].parameters.visibleRegion.width == window->w &&
-            mode_props[i].parameters.visibleRegion.height == window->h) {
+        if (mode_props[i].parameters.visibleRegion.width == surf_w &&
+            mode_props[i].parameters.visibleRegion.height == surf_h) {
             display_mode_props = mode_props[i];
             mode_found = true;
             break;
@@ -370,8 +380,8 @@ bool KMSDRM_Vulkan_CreateSurface(SDL_VideoDevice *_this,
            This won't work for some video chips atm (like Pi's VideoCore) so these are limited
            to supported resolutions. Don't try to use "closest" resolutions either, because
            those are often bigger than the window size, thus causing out-of-bunds scanout. */
-        new_mode_parameters.visibleRegion.width = window->w;
-        new_mode_parameters.visibleRegion.height = window->h;
+        new_mode_parameters.visibleRegion.width = surf_w;
+        new_mode_parameters.visibleRegion.height = surf_h;
         /* SDL (and DRM, if we look at drmModeModeInfo vrefresh) uses plain integer Hz for
            display mode refresh rate, but Vulkan expects higher precision. */
         new_mode_parameters.refreshRate = (uint32_t)(window->current_fullscreen_mode.refresh_rate * 1000);
@@ -469,8 +479,8 @@ bool KMSDRM_Vulkan_CreateSurface(SDL_VideoDevice *_this,
     // Let's finally create the Vulkan surface!
     /********************************************/

-    image_size.width = window->w;
-    image_size.height = window->h;
+    image_size.width = surf_w;
+    image_size.height = surf_h;

     SDL_zero(display_plane_surface_create_info);
     display_plane_surface_create_info.sType = VK_STRUCTURE_TYPE_DISPLAY_SURFACE_CREATE_INFO_KHR;
